@model TournamentManager.ViewModels.CrearTorneoVM

@{
    ViewData["Title"] = "Crear Nuevo Torneo";
}

<style>
    /* --- ESTILOS NEON / CYBERPUNK --- */
    :root {
        --rl-blue: #00a8ff;
        --rl-purple: #6c5ce7;
        --rl-panel: rgba(255, 255, 255, 0.05);
        --rl-dark: #0f0f13;
    }

    body {
        background-color: #050505;
        color: white;
    }

    .neon-card {
        background: var(--rl-panel);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 0 40px rgba(0,0,0,0.6);
        max-width: 900px;
        margin: 40px auto;
    }

    .neon-title {
        font-style: italic;
        font-weight: 900;
        text-transform: uppercase;
        background: -webkit-linear-gradient(45deg, #fff, var(--rl-blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 20px rgba(0,168,255,0.4);
        margin-bottom: 30px;
        text-align: center;
    }

    .form-label-neon {
        display: block;
        color: var(--rl-blue);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.85rem;
        margin-bottom: 8px;
        letter-spacing: 1px;
        height: 20px;
    }

    .form-control-neon {
        background-color: rgba(0,0,0,0.4);
        border: 1px solid #444;
        color: white;
        border-radius: 5px;
        padding: 10px 12px;
        transition: 0.3s;
        color-scheme: dark;
        width: 100%;
        height: 45px;
    }

        .form-control-neon:focus {
            background-color: rgba(0,0,0,0.6);
            outline: none;
            border-color: var(--rl-purple);
            box-shadow: 0 0 15px rgba(108,92,231,0.4);
            color: white;
        }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 10px;
        margin: 30px 0 20px 0;
    }

    .bracket-section-title {
        color: var(--rl-purple);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin: 0;
    }

    .btn-random {
        background: transparent;
        border: 1px solid var(--rl-blue);
        color: var(--rl-blue);
        padding: 5px 15px;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: bold;
        border-radius: 20px;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-random:hover {
            background: var(--rl-blue);
            color: white;
            box-shadow: 0 0 15px var(--rl-blue);
        }

    .matchup-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 15px 10px;
        position: relative;
        transition: 0.3s;
    }

    .matchup-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .team-select-wrapper {
        flex: 1;
        min-width: 0;
    }

    .matchup-card .form-control-neon {
        font-size: 0.9rem;
        padding: 5px 8px;
        height: 38px;
        text-overflow: ellipsis;
    }

    .vs-badge {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, var(--rl-blue), var(--rl-purple));
        border-radius: 50%;
        font-weight: 900;
        font-style: italic;
        font-size: 0.65rem;
        box-shadow: 0 0 10px var(--rl-purple);
        z-index: 2;
    }

    .btn-create-neon {
        background: linear-gradient(90deg, var(--rl-blue), var(--rl-purple));
        border: none;
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        padding: 15px 0;
        width: 100%;
        margin-top: 30px;
        clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
        transition: 0.3s;
        cursor: pointer;
        display: block;
        text-align: center;
    }

        .btn-create-neon:hover {
            transform: scale(1.02);
            box-shadow: 0 0 25px var(--rl-blue);
            color: white;
        }

    /* Mensaje de error */
    .error-message {
        background: rgba(255,0,0,0.2);
        border: 1px solid red;
        padding: 10px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        color: white;
        text-align: center;
        font-weight: bold;
        text-transform: uppercase;
        box-shadow: 0 0 10px red;
    }
</style>

<div class="neon-card">
    <h2 class="neon-title">Configurar Torneo</h2>

    @* Mostrar mensaje de error si hay *@
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="error-message">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Crear" method="post">

        <div class="row mb-4 align-items-end">
            <div class="col-md-8">
                <div class="form-group">
                    <label class="form-label-neon"><i class="bi bi-trophy"></i> Nombre del Torneo</label>
                    <input asp-for="Nombre" placeholder="Ej: Championship Series S1" class="form-control-neon" autocomplete="off" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="form-label-neon"><i class="bi bi-calendar-event"></i> Fecha de Inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control-neon" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="section-header">
            <h4 class="bracket-section-title">
                <i class="bi bi-diagram-3"></i> Cuartos de Final
            </h4>
            <button type="button" onclick="generarAleatorio()" class="btn-random">
                <i class="bi bi-shuffle"></i> Aleatorio
            </button>
        </div>

        <div class="row g-3">
            @for (int match = 1; match <= 4; match++)
            {
                int teamA = (match - 1) * 2 + 1;
                int teamB = (match - 1) * 2 + 2;

                <div class="col-md-6">
                    <div class="matchup-card">
                        <div class="matchup-container">

                            <div class="team-select-wrapper">
                                <label class="text-muted small mb-1 d-block text-center">Seed #@teamA</label>
                                <select name="QF@(teamA)" class="form-control-neon equipo-select text-center">
                                    <option value="">-- Elegir --</option>
                                    @foreach (var e in ViewBag.Equipos)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="vs-badge">VS</div>

                            <div class="team-select-wrapper">
                                <label class="text-muted small mb-1 d-block text-center">Seed #@teamB</label>
                                <select name="QF@(teamB)" class="form-control-neon equipo-select text-center">
                                    <option value="">-- Elegir --</option>
                                    @foreach (var e in ViewBag.Equipos)
                                    {
                                        <option value="@e.Id">@e.Nombre</option>
                                    }
                                </select>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="submit" class="btn-create-neon">
            <i class="bi bi-rocket-takeoff-fill"></i> Lanzar Torneo
        </button>
    </form>
</div>

<script>
    const selects = document.querySelectorAll(".equipo-select");

    // Evita duplicados visualmente
    function actualizarOpciones() {
        const seleccionados = Array.from(selects)
            .map(s => s.value)
            .filter(v => v !== "");

        selects.forEach(s => {
            Array.from(s.options).forEach(o => {
                if (o.value === "") return;
                o.disabled = seleccionados.includes(o.value) && s.value !== o.value;
            });
        });
    }

    // Generación Aleatoria
    function generarAleatorio() {
        let opciones = Array.from(selects[0].options)
            .map(o => o.value)
            .filter(v => v !== "");

        if (opciones.length < 8) {
            alert("Necesitas al menos 8 equipos registrados para hacer un sorteo completo.");
            return;
        }

        for (let i = opciones.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [opciones[i], opciones[j]] = [opciones[j], opciones[i]];
        }

        selects.forEach((select, index) => {
            if (index < opciones.length) select.value = opciones[index];
        });

        actualizarOpciones();
    }

    selects.forEach(s => s.addEventListener("change", actualizarOpciones));
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
