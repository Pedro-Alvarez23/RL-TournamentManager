@model TournamentManager.Models.Partido

@{
    ViewData["Title"] = "Detalles del Partido";
    bool jugado = Model.Jugado;

    // Recuperamos los equipos de forma segura
    var equiposOrdenados = Model.Equipos.OrderBy(e => e.Id).ToList();

    var equipoLocalEP = equiposOrdenados.Count > 0 ? equiposOrdenados[0] : null;
    var equipoVisitanteEP = equiposOrdenados.Count > 1 ? equiposOrdenados[1] : null;

    string nombreLocal = equipoLocalEP?.Equipo?.Nombre ?? "TBD";
    string nombreVisitante = equipoVisitanteEP?.Equipo?.Nombre ?? "TBD";

    // --- NUEVO: Recuperamos imágenes o ponemos un placeholder transparente/vacío si no hay ---
    string imgLocal = equipoLocalEP?.Equipo?.Logo ?? "https://via.placeholder.com/150?text=?";
    string imgVisitante = equipoVisitanteEP?.Equipo?.Logo ?? "https://via.placeholder.com/150?text=?";

    int golesLocal = equipoLocalEP?.Goles ?? 0;
    int golesVisitante = equipoVisitanteEP?.Goles ?? 0;
}

<style>
    /* Estilos Neon/Dark */
    :root {
        --rl-blue: #00a8ff;
        --rl-orange: #ff9f43;
        --rl-bg: #0f0f13;
        --rl-glass: rgba(255, 255, 255, 0.05);
    }

    body {
        background-color: var(--rl-bg);
        color: white;
    }

    /* Scoreboard */
    .scoreboard-header {
        text-align: center;
        margin-bottom: 30px;
        margin-top: 20px;
    }

    .round-badge {
        background: linear-gradient(45deg, #6c5ce7, #a29bfe);
        padding: 5px 20px;
        border-radius: 20px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.8rem;
        box-shadow: 0 0 15px rgba(108, 92, 231, 0.4);
    }

    .score-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
        margin-bottom: 20px;
    }

    /* --- NUEVO: Contenedor para alinear Nombre + Logo --- */
    .team-identity {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 40%; /* Ajustado para que quepan los logos */
    }

        /* Alineación específica para local (derecha) y visitante (izquierda) */
        .team-identity.local {
            justify-content: flex-end;
            text-align: right;
        }

        .team-identity.visitor {
            justify-content: flex-start;
            text-align: left;
        }

    .team-logo-header {
        width: 70px;
        height: 70px;
        object-fit: contain;
        filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
    }

    .team-logo-card {
        width: 50px;
        height: 50px;
        object-fit: contain;
        margin-right: 15px;
    }
    /* ---------------------------------------------------- */

    .team-name-large {
        font-size: 1.8rem;
        font-weight: 800;
        text-transform: uppercase;
        /* width: 35%;  <-- ELIMINADO: Ahora lo controla el contenedor padre .team-identity */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .score-box {
        background: #000;
        color: white;
        font-family: 'Courier New', monospace;
        font-size: 3rem;
        font-weight: 900;
        padding: 10px 30px;
        border-radius: 10px;
        border: 2px solid #333;
        min-width: 180px;
        position: relative;
        text-align: center;
        white-space: nowrap;
    }

        .score-box::after {
            content: 'VS';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.7rem;
            background: #333;
            padding: 2px 6px;
            border-radius: 4px;
        }

    /* Botón Central de Regreso */
    .btn-return-index {
        display: inline-block;
        margin-top: 15px;
        padding: 8px 25px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 30px;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        transition: 0.3s;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

        .btn-return-index:hover {
            background: rgba(255,255,255,0.1);
            color: white;
            border-color: white;
            box-shadow: 0 0 15px rgba(255,255,255,0.2);
        }

    /* Colores */
    .text-blue {
        color: var(--rl-blue);
        text-shadow: 0 0 15px rgba(0, 168, 255, 0.4);
    }

    .text-orange {
        color: var(--rl-orange);
        text-shadow: 0 0 15px rgba(255, 159, 67, 0.4);
    }

    .border-blue {
        border-color: var(--rl-blue);
        box-shadow: 0 0 20px rgba(0, 168, 255, 0.2);
    }

    .border-orange {
        border-color: var(--rl-orange);
        box-shadow: 0 0 20px rgba(255, 159, 67, 0.2);
    }

    .text-tbd {
        color: #555;
        font-style: italic;
    }

    /* Cards */
    .stats-card {
        background: var(--rl-glass);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,0.1);
        padding: 20px;
        height: 100%;
        transition: 0.3s;
    }

        .stats-card:hover {
            transform: translateY(-5px);
            background: rgba(255,255,255,0.08);
        }

    .card-header-team {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 15px;
        margin-bottom: 15px;
    }

    /* Filas de Jugadores */
    .player-row {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

        .player-row:last-child {
            border-bottom: none;
        }

    /* Enlace del Jugador */
    .player-link {
        flex-grow: 1;
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        transition: 0.2s;
    }

        /* Efecto Hover en el nombre del jugador */
        .player-link:hover .player-nick {
            color: white !important;
            text-shadow: 0 0 10px rgba(255,255,255,0.8);
            transform: translateX(5px);
        }

        /* Icono de transición al hacer hover */
        .player-link:hover i {
            color: white !important;
        }

    .player-nick {
        font-weight: 600;
        font-size: 1.1rem;
        transition: 0.2s;
    }

    .mvp-icon {
        color: #ffd700;
        animation: glow 1.5s infinite alternate;
    }

    .stats-pills {
        display: flex;
        gap: 8px;
    }

    .stat-pill {
        background: rgba(0,0,0,0.3);
        padding: 5px 8px;
        border-radius: 6px;
        font-size: 0.85rem;
        min-width: 45px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1);
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.5);
        text-transform: uppercase;
    }

    .stat-value {
        font-weight: bold;
        color: white;
        line-height: 1;
        margin-top: 2px;
    }

    .btn-back-floating {
        position: fixed;
        top: 20px;
        left: 20px;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 1.2rem;
        transition: 0.3s;
    }

        .btn-back-floating:hover {
            color: white;
            transform: translateX(-5px);
        }

    @@keyframes glow {
        from {
            text-shadow: 0 0 5px #ffd700;
        }

        to {
            text-shadow: 0 0 20px #ffd700;
        }
    }
</style>

<div class="container py-5">

    <a href="javascript:history.back()" class="btn-back-floating"><i class="bi bi-arrow-left"></i></a>

    <div class="scoreboard-header">
        <span class="round-badge">@Model.Ronda?.Nombre - @Model.Ronda?.Torneo?.Nombre</span>

        <div class="score-container">
            <div class="team-identity local">
                <div class="team-name-large @(equipoLocalEP != null ? "text-blue" : "text-tbd")">
                    @nombreLocal
                </div>
                @if (equipoLocalEP != null)
                {
                    <img src="@imgLocal" alt="Logo Local" class="team-logo-header" />
                }
            </div>

            <div class="score-box @(jugado ? (golesLocal > golesVisitante ? "border-blue" : "border-orange") : "")">
                @golesLocal - @golesVisitante
            </div>

            <div class="team-identity visitor">
                @if (equipoVisitanteEP != null)
                {
                    <img src="@imgVisitante" alt="Logo Visitante" class="team-logo-header" />
                }
                <div class="team-name-large @(equipoVisitanteEP != null ? "text-orange" : "text-tbd")">
                    @nombreVisitante
                </div>
            </div>
        </div>

        <div class="mb-3">
            @if (!jugado)
            {
                <span class="badge bg-secondary">Pendiente</span>
            }
            else
            {

                <span class="badge bg-success">Finalizado</span>
            }
        </div>

        <div>
            <a asp-action="Index" class="btn-return-index">
                <i class="bi bi-list-ul me-2"></i> Volver al listado
            </a>
        </div>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-md-5">
            @if (equipoLocalEP != null && equipoLocalEP.Equipo != null)
            {
                <div class="stats-card" style="border-top: 4px solid var(--rl-blue);">
                    <div class="card-header-team">
                        <div class="d-flex align-items-center">
                            <img src="@imgLocal" class="team-logo-card" alt="Logo" />
                            <h4 class="m-0 text-blue">@equipoLocalEP.Equipo.Nombre</h4>
                        </div>
                        <span class="fs-4 fw-bold text-blue">@equipoLocalEP.Goles <small class="fs-6 text-muted">GOLES</small></span>
                    </div>

                    <div class="players-list">
                        @foreach (var jugador in equipoLocalEP.Equipo.Jugadores)
                        {
                            var stats = jugador.HistorialPartidos?
                            .FirstOrDefault(pj => pj.EquipoPartidoId == equipoLocalEP.Id);

                            bool isMvp = (jugador.Id == Model.MVPJugadorId);

                            <div class="player-row">
                                <a asp-controller="Jugador" asp-action="Details" asp-route-id="@jugador.Id" class="player-link" title="Ver perfil de @jugador.Nick">
                                    @if (isMvp)
                                    {
                                        <i class="bi bi-trophy-fill mvp-icon"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-person text-muted"></i>
                                    }

                                    <span class="player-nick @(isMvp ? "text-warning" : "text-white")">
                                        @jugador.Nick
                                    </span>
                                </a>

                                <div class="stats-pills">
                                    <div class="stat-pill">
                                        <span class="stat-label">GOL</span>
                                        <span class="stat-value" style="color:#2ed573">@(stats?.Goles ?? 0)</span>
                                    </div>
                                    <div class="stat-pill">
                                        <span class="stat-label">AST</span>
                                        <span class="stat-value" style="color:#70a1ff">@(stats?.Asistencias ?? 0)</span>
                                    </div>
                                    <div class="stat-pill">
                                        <span class="stat-label">SAV</span>
                                        <span class="stat-value" style="color:#ff7675">@(stats?.Salvadas ?? 0)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-dark text-center mt-5" role="alert">
                    <i class="bi bi-question-circle"></i> Equipo Local por definir
                </div>
            }
        </div>

        <div class="col-md-5">
            @if (equipoVisitanteEP != null && equipoVisitanteEP.Equipo != null)
            {
                <div class="stats-card" style="border-top: 4px solid var(--rl-orange);">
                    <div class="card-header-team">
                        <div class="d-flex align-items-center">
                            <img src="@imgVisitante" class="team-logo-card" alt="Logo" />
                            <h4 class="m-0 text-orange">@equipoVisitanteEP.Equipo.Nombre</h4>
                        </div>
                        <span class="fs-4 fw-bold text-orange">@equipoVisitanteEP.Goles <small class="fs-6 text-muted">GOLES</small></span>
                    </div>

                    <div class="players-list">
                        @foreach (var jugador in equipoVisitanteEP.Equipo.Jugadores)
                        {
                            var stats = jugador.HistorialPartidos?
                            .FirstOrDefault(pj => pj.EquipoPartidoId == equipoVisitanteEP.Id);

                            bool isMvp = (jugador.Id == Model.MVPJugadorId);

                            <div class="player-row">
                                <a asp-controller="Jugador" asp-action="Details" asp-route-id="@jugador.Id" class="player-link" title="Ver perfil de @jugador.Nick">
                                    @if (isMvp)
                                    {
                                        <i class="bi bi-trophy-fill mvp-icon"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-person text-muted"></i>
                                    }

                                    <span class="player-nick @(isMvp ? "text-warning" : "text-white")">
                                        @jugador.Nick
                                    </span>
                                </a>

                                <div class="stats-pills">
                                    <div class="stat-pill">
                                        <span class="stat-label">GOL</span>
                                        <span class="stat-value" style="color:#2ed573">@(stats?.Goles ?? 0)</span>
                                    </div>
                                    <div class="stat-pill">
                                        <span class="stat-label">AST</span>
                                        <span class="stat-value" style="color:#70a1ff">@(stats?.Asistencias ?? 0)</span>
                                    </div>
                                    <div class="stat-pill">
                                        <span class="stat-label">SAV</span>
                                        <span class="stat-value" style="color:#ff7675">@(stats?.Salvadas ?? 0)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-dark text-center mt-5" role="alert">
                    <i class="bi bi-question-circle"></i> Equipo Visitante por definir
                </div>
            }
        </div>

    </div>
</div>