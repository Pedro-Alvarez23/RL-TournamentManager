@model TournamentManager.Models.Partido

@{
    bool readOnly = Model.Jugado;
    ViewData["Title"] = readOnly ? "Final Result" : "Play Match";
}

<style>
    /* Estilos base */
    .match-control-card { background: rgba(20, 20, 25, 0.95); border: 1px solid rgba(255,255,255,0.1); border-radius: 15px; box-shadow: 0 0 50px rgba(0,0,0,0.8); padding: 30px; margin-top: 20px; }
    
    .team-header { 
        text-align: center; 
        margin-bottom: 20px; 
        padding-bottom: 10px; 
        border-bottom: 2px solid; 
        /* Flex para centrar logo y texto */
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }
    
    /* LOGO EN CABECERA DE MATCH */
    .team-logo-header {
        height: 35px; /* Un poco más grande que en el bracket */
        width: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 5px rgba(255,255,255,0.5));
    }

    .team-blue .team-header { border-color: var(--rl-blue); color: var(--rl-blue); }
    .team-orange .team-header { border-color: #ff9f43; color: #ff9f43; }
    
    .stat-table th { color: rgba(255,255,255,0.5); font-weight: 400; font-size: 0.8rem; text-transform: uppercase; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
    .stat-table td { padding: 10px 5px; vertical-align: middle; }
    .player-name { font-weight: bold; font-size: 0.95rem; color: white; }
    
    .stat-input { background: #000; border: 1px solid #333; color: white; text-align: center; font-family: 'Courier New', monospace; font-weight: bold; border-radius: 4px; padding: 5px; width: 100%; transition: 0.3s; }
    .stat-input:focus { border-color: var(--rl-blue); outline: none; box-shadow: 0 0 10px rgba(0, 168, 255, 0.3); }
    
    .total-score-box { background: rgba(0,0,0,0.5); border-radius: 10px; padding: 15px; text-align: center; margin-top: 20px; }
    .total-number { font-size: 2.5rem; font-weight: 900; line-height: 1; display: block; }
    .error-message { background: rgba(255,0,0,0.2); border: 1px solid red; padding: 10px 15px; border-radius: 8px; margin-bottom: 20px; color: white; text-align: center; font-weight: bold; text-transform: uppercase; box-shadow: 0 0 10px red; }
    
    .stat-readonly { font-family: 'Courier New', monospace; font-weight: 900; font-size: 1.2rem; color: #fff; text-align: center; display: block; }
    
    .btn-confirm-match { background: linear-gradient(90deg, #2ed573, #26de81); border: none; color: #000; font-weight: 900; text-transform: uppercase; padding: 15px 40px; font-size: 1.2rem; clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px); transition: 0.3s; margin-top: 30px; display: inline-block; }
    .btn-confirm-match:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(46, 213, 115, 0.4); }
    .btn-back { background: transparent; border: 1px solid rgba(255,255,255,0.2); color: white; padding: 10px 30px; border-radius: 30px; margin-top: 30px; text-transform: uppercase; font-size: 0.9rem; transition: 0.3s; text-decoration: none; display: inline-block; }
    .btn-back:hover { background: white; color: black; }
</style>

<div class="container">
    <h2 class="text-center mb-4 fst-italic text-uppercase">
        @if (readOnly)
        {
            <span style="color:#ffd700">Resultado</span> <span class="text-white">Final</span>
        }
        else
        {
            <span style="color:#00a8ff">Registrar</span> <span class="text-white">Resultado</span>
        }
    </h2>

    @if (TempData["Error"] != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    @if (!readOnly) { 
        <form asp-action="Play" method="post" class="match-control-card"> 
            <input type="hidden" name="Id" value="@Model.Id" /> 
            <div class="row g-5"> @RenderBodyContent() </div> 
            <div class="text-center"><button type="submit" class="btn-confirm-match"><i class="bi bi-check2-circle"></i> Confirmar Resultado</button></div> 
        </form> 
    }
    else { 
        <div class="match-control-card"> 
            <div class="row g-5"> @RenderBodyContent() </div> 
            <div class="text-center"><a href="javascript:history.back()" class="btn-back"><i class="bi bi-arrow-left"></i> Volver</a></div> 
        </div> 
    }
</div>

@{
    object RenderBodyContent()
    {
        int counter = 0;
        foreach (var ep in Model.Equipos)
        {
            string themeClass = counter == 0 ? "team-blue" : "team-orange";
            counter++;

            <div class="col-md-6 @themeClass">
                <h3 class="team-header">
                    @if(!string.IsNullOrEmpty(ep.Equipo.Logo))
                    {
                        <img src="@ep.Equipo.Logo" class="team-logo-header" />
                    }
                    @ep.Equipo!.Nombre
                </h3>

                <table class="w-100 stat-table">
                    <thead>
                        <tr>
                            <th class="text-start">Jugador</th>
                            <th style="width: 70px">Goles</th>
                            <th style="width: 70px">Asist.</th>
                            <th style="width: 70px">Saves</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var j in ep.Equipo.Jugadores)
                        {
                            var stats = ep.EstadisticasJugadores.FirstOrDefault(s => s.JugadorId == j.Id);
                            int g = stats?.Goles ?? 0;
                            int a = stats?.Asistencias ?? 0;
                            int s = stats?.Salvadas ?? 0;

                            <tr>
                                <td class="player-name">@j.Nick</td>
                                <td>
                                    @if(readOnly) { <span class="stat-readonly">@g</span> }
                                    else { <input class="stat-input input-goles" data-team-id="@ep.Equipo.Id" name="g_@j.Id" type="number" min="0" value="0" /> }
                                </td>
                                <td>
                                    @if(readOnly) { <span class="stat-readonly">@a</span> }
                                    else { <input class="stat-input" name="a_@j.Id" type="number" min="0" value="0" /> }
                                </td>
                                <td>
                                    @if(readOnly) { <span class="stat-readonly">@s</span> }
                                    else { <input class="stat-input" name="s_@j.Id" type="number" min="0" value="0" /> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="total-score-box">
                    <small class="text-muted text-uppercase">Total Goles</small>
                    <span class="total-number" id="total_@ep.Equipo.Id" style="color: @(counter == 1 ? "var(--rl-blue)" : "#ff9f43")">
                        @(readOnly ? ep.Goles : 0)
                    </span>
                </div>
            </div>
        }
        return null;
    }
}

@if (!readOnly)
{
    <script>
        document.querySelectorAll(".input-goles").forEach(input => {
            input.addEventListener("input", function() {
                const teamId = this.getAttribute("data-team-id");
                const inputsDelEquipo = document.querySelectorAll(`.input-goles[data-team-id='${teamId}']`);
                let total = 0;
                inputsDelEquipo.forEach(i => total += parseInt(i.value || 0));
                const display = document.getElementById(`total_${teamId}`);
                if(display) display.innerText = total;
            });
        });
    </script>
}